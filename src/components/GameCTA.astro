---
---

<div class="game-inner reveal">
  <div class="game-text">
    <p class="game-desc">I made a totally fair game of tic-tac-toe. No cheating. Definitely no cheating. If you win, you don't have to hire me.</p>
    <p class="game-disclaimer">(You won't win.)</p>
  </div>
  <iframe
    src="/game.html"
    class="game-iframe"
    title="Tic-Tac-Toe: Totally Fair Edition"
    scrolling="no"
    loading="lazy"
  ></iframe>
</div>

<script>
  // The game posts its content height whenever it changes (for example when
  // the board grows a fourth row), so the iframe never cuts off its ending.
  const frame = document.querySelector<HTMLIFrameElement>('.game-iframe');
  window.addEventListener('message', (e) => {
    if (!frame || e.origin !== location.origin || e.source !== frame.contentWindow) return;
    if (e.data?.type !== 'ttt-height' || typeof e.data.height !== 'number') return;
    frame.style.height = `${Math.ceil(e.data.height)}px`;
  });
</script>

<style>
  .game-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .game-text {
    max-width: 520px;
  }

  .game-desc {
    color: var(--fg-body);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 8px;
  }

  .game-disclaimer {
    color: var(--fg-muted);
    font-size: 0.85rem;
    font-style: italic;
  }

  .game-iframe {
    display: block;
    width: 100%;
    height: 600px;
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    border-radius: 12px;
    background: transparent;
  }

  @media (max-width: 768px) {
    .game-text {
      max-width: none;
    }

    .game-iframe {
      height: 520px;
    }
  }
</style>
