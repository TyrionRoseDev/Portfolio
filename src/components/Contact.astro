<section class="cta" id="contact">
  <div class="cta-bg-text" aria-hidden="true">Say hello</div>
  <div class="reveal">
    <div class="cta-num">04 · CONTACT</div>
    <h2 class="cta-heading">Let's work <br /><em>together</em></h2>
    <p class="cta-sub">Whether it's a full-time role, freelance project, or a website for your business, I'm available. Let's chat.</p>
    <div class="cta-email-wrap">
      <button type="button" class="cta-email" data-email="tyrionrose01@gmail.com" aria-describedby="cta-email-hint">tyrionrose01@gmail.com</button>
      <p class="cta-hint" id="cta-email-hint">
        <span class="cta-hint-default">Click to copy, or <a href="mailto:tyrionrose01@gmail.com">open your email app</a></span>
        <span class="cta-copied" role="status"></span>
      </p>
    </div>
    <div class="cta-or">or find me on</div>
    <div class="cta-socials">
      <a href="https://github.com/TyrionRoseDev" class="cta-social" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/tyrion-rose-meredith/" class="cta-social" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 180px 56px; text-align: center;
    position: relative; overflow: hidden;
    max-width: 1100px; margin: 0 auto;
  }
  .cta-bg-text {
    font-family: var(--font-serif);
    font-size: 200px; font-weight: 900;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent-light);
    position: absolute; bottom: 60px; left: 50%; transform: translateX(-50%);
    white-space: nowrap; user-select: none; opacity: 0.5;
  }
  .cta-num { font-size: 11px; letter-spacing: 4px; color: var(--accent); font-weight: 500; margin-bottom: 24px; }
  .cta-heading {
    font-family: var(--font-serif);
    font-size: 80px; font-weight: 900; letter-spacing: -3px;
    color: var(--fg); line-height: 0.95; margin-bottom: 20px;
    position: relative; z-index: 1;
  }
  .cta-heading em { font-style: italic; font-weight: 500; color: var(--accent); }
  .cta-sub { font-size: 17px; color: var(--fg-light); margin-bottom: 48px; font-weight: 350; position: relative; z-index: 1; }
  .cta-email-wrap { position: relative; z-index: 1; }
  .cta-email {
    font-family: var(--font-serif);
    font-size: 28px; color: var(--accent); font-weight: 700;
    display: inline-block; padding-bottom: 6px;
    background: none; border: none; cursor: pointer;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0 2px; background-position: 0 100%; background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cta-email:hover { background-size: 100% 2px; }
  .cta-hint {
    position: relative; margin-top: 10px; font-size: 13px; color: var(--fg-muted);
  }
  .cta-hint a { color: var(--fg-light); text-underline-offset: 3px; }
  .cta-hint a:hover { color: var(--accent); }
  .cta-hint-default { transition: opacity 0.3s; }
  .cta-copied {
    position: absolute; inset: 0; color: var(--accent);
    opacity: 0; transition: opacity 0.3s; font-weight: 500; letter-spacing: 1px;
  }
  .cta-hint.copied .cta-hint-default { opacity: 0; }
  .cta-hint.copied .cta-copied { opacity: 1; }
  .cta-or { font-size: 13px; color: var(--fg-muted); margin: 20px 0; font-style: italic; position: relative; z-index: 1; }
  .cta-socials { display: flex; gap: 16px; justify-content: center; position: relative; z-index: 1; }
  .cta-social {
    padding: 12px 28px; border: 1.5px solid var(--border); border-radius: 100px;
    font-size: 11px; text-transform: uppercase; letter-spacing: 2px;
    color: var(--fg-muted); text-decoration: none; font-weight: 500;
    transition: all 0.3s;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    backdrop-filter: blur(8px);
  }
  .cta-social:hover {
    border-color: var(--accent); color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  @media (max-width: 768px) {
    .cta { padding: 100px 24px; }
    .cta-heading { font-size: 44px; letter-spacing: -1.5px; }
    .cta-email { font-size: 20px; }
    .cta-bg-text { font-size: 84px; bottom: 16px; opacity: 0.35; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.cta-email');
  const hint = document.querySelector('.cta-hint');
  const copied = document.querySelector('.cta-copied');
  let timer: ReturnType<typeof setTimeout>;
  btn?.addEventListener('click', async () => {
    const email = btn.dataset.email;
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      // No clipboard access (older browser or insecure context), so open the mail app instead.
      location.href = `mailto:${email}`;
      return;
    }
    if (copied) copied.textContent = 'Copied to your clipboard!';
    hint?.classList.add('copied');
    clearTimeout(timer);
    timer = setTimeout(() => {
      hint?.classList.remove('copied');
      if (copied) copied.textContent = '';
    }, 2200);
  });
</script>
