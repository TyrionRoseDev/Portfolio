---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found · Tyrion Meredith" description="This page doesn't exist." noindex>
  <main id="main" tabindex="-1" class="nf">
    <div class="nf-num" aria-hidden="true">404</div>
    <div class="nf-label">Page not found</div>
    <h1 class="nf-title">Well, this is <em>awkward</em>.</h1>
    <p class="nf-sub">The page you're after has wandered off. It might have moved, or the link might be wrong.</p>
    <div class="nf-links">
      <a href="/" class="nf-link nf-link-fill">Take me home</a>
      <a href="/projects" class="nf-link nf-link-ghost">See my projects</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    min-height: 100vh; max-width: 1100px; margin: 0 auto;
    padding: 160px 56px 120px; position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
  }
  .nf-num {
    position: absolute; right: 24px; top: 50%; margin-top: -180px;
    font-family: var(--font-serif); font-size: 360px; font-weight: 900; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent-light); opacity: 0.5;
    user-select: none; animation: float1 8s ease-in-out infinite;
  }
  .nf-label {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: var(--accent); font-weight: 500; margin-bottom: 24px; position: relative;
  }
  .nf-title {
    font-family: var(--font-serif); font-size: 80px; font-weight: 900;
    letter-spacing: -3px; line-height: 0.95; color: var(--fg);
    margin-bottom: 24px; position: relative;
  }
  .nf-title em { font-style: italic; font-weight: 500; color: var(--accent); }
  .nf-sub {
    font-size: 17px; color: var(--fg-light); line-height: 1.7;
    max-width: 440px; font-weight: 350; margin-bottom: 40px; position: relative;
  }
  .nf-links { display: flex; gap: 16px; flex-wrap: wrap; position: relative; }
  .nf-link {
    padding: 14px 32px; border-radius: 100px; font-size: 12px; font-weight: 600;
    text-decoration: none; text-transform: uppercase; letter-spacing: 2px; transition: all 0.3s;
  }
  .nf-link-fill { background: var(--accent); color: var(--on-accent); }
  .nf-link-fill:hover { transform: translateY(-2px); box-shadow: 0 8px 24px color-mix(in srgb, var(--accent) 30%, transparent); }
  .nf-link-ghost { border: 1.5px solid var(--border); color: var(--fg-light); }
  .nf-link-ghost:hover { border-color: var(--accent); color: var(--accent); }

  @media (max-width: 768px) {
    .nf { padding: 120px 24px 80px; }
    .nf-num { font-size: 180px; right: -20px; top: 22%; margin-top: -90px; }
    .nf-title { font-size: 48px; letter-spacing: -1.5px; }
  }
</style>
